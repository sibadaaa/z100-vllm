# Window R: O7 piecewise CUDA-graph attempt (plan §3 O7, time-boxed).
# Only difference from r_control is ARM_LAUNCHER: --enforce-eager dropped and
# --compilation-config '{"cudagraph_mode":"piecewise"}' added. The verdict is
# decided by the engine's OWN resolved cudagraph_mode (startup log), never by the
# flag we passed -- if it resolves to FULL or NONE the arm is "piecewise not
# exercised", not a success.
ARM_DESC="O7: piecewise cudagraph attempt (enforce-eager dropped, compile on)"
ARM_PROFILE="o7-piecewise-cfg35"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=0 VLLM_DCU_FP8_QUANT_FASTPATH=0 VLLM_DCU_FP8_FUSE_QUANT=0 VLLM_DCU_FP8_DECODE_CFG=35"
ARM_SO=${S23_CAND_SO:-7f87e185c628bd3c54c53ff9d5e0d78a}
ARM_LAUNCHER=/home/lyh/z100-vllm/tools/dcu/s23_launch_piecewise.sh
ARM_EXPECT_GATE=off
# Compile mode spends minutes in torch.compile before ready; fast-fail still
# catches a crash inside ~10 s.
ARM_READY_TRIES=400
ARM_LOGSCAN=1
ARM_PREFLIGHT_EXPECT=""
