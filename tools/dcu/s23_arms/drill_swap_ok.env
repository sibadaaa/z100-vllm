# Rollback drill, success branch: promote a *working* candidate .so (a real build
# from /mnt/game/perf1/_rocm_C.<md5>.so), verify md5 + ready + smoke, then let the
# window's restore path roll back to the baseline and prove identity. Set
# S23_DRILL_SO=<md5> when running, or edit ARM_SO to the candidate md5.
ARM_DESC="rollback drill: promote candidate .so, then roll back to baseline"
ARM_PROFILE="drill-swap-then-rollback"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=0 VLLM_DCU_FP8_QUANT_FASTPATH=0 VLLM_DCU_FP8_FUSE_QUANT=0"
ARM_SO=${S23_DRILL_SO:?set S23_DRILL_SO to the candidate md5}
ARM_READY_TRIES=150
ARM_PREFLIGHT_EXPECT=""
