# CONTROL arm: today's default production configuration.
#
# The three S23 switches are set to an explicit 0 (rather than left unset) so the
# descriptor can prove the plumbing works even in the negative arm: if the arm
# env never reached the engine, the mismatch check fires on the control arm too,
# instead of only showing up as "the treatment arm looks like the control".
ARM_DESC="control: default config, EMU_FASTPATH=0 QUANT_FASTPATH=0 FUSE_QUANT=0"
ARM_PROFILE="prod-dflash2-tp4-eager-cfg16-gemvM8"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=0 VLLM_DCU_FP8_QUANT_FASTPATH=0 VLLM_DCU_FP8_FUSE_QUANT=0"
ARM_SO=""
ARM_PREFLIGHT_EXPECT="--expect VLLM_DCU_FP8_EMU_FASTPATH=0"
