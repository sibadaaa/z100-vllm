# O4 gate on top of the promoted config: O4's auto criterion
# (VLLM_DCU_FP8_STREAM_MAX_M) sends the 5120:1536 shape to the tile kernel once
# M reaches the threshold; unset = today's stream behaviour. Only meaningful on a
# build that carries the O4 gate (kernel-dev's combined artifact).
ARM_DESC="cand cfg35 + VLLM_DCU_FP8_STREAM_MAX_M=8 (O4 gate on)"
ARM_PROFILE="cand-cfg35-o4-on"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=0 VLLM_DCU_FP8_QUANT_FASTPATH=0 VLLM_DCU_FP8_FUSE_QUANT=0 VLLM_DCU_FP8_DECODE_CFG=35 VLLM_DCU_FP8_STREAM_MAX_M=8"
ARM_SO=${S23_CAND_SO:-7f87e185c628bd3c54c53ff9d5e0d78a}
ARM_PREFLIGHT_EXPECT=""
# Kernel census falsifier: with the O4 gate on, the M=8 census must show
# wide2 and NO stream kernel for 5120:1536; with the gate off the stream kernel
# must still appear.
ARM_EXPECT_GATE=on
