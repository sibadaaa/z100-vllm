# Window Q arm 3 = THE RECOMMENDED PRODUCTION CONFIGURATION.
# Everything that survived its gates: O3 cfg35 kernel build (7f87e185), O2 quant
# fast path, O1 emu fast path. O4's STREAM_MAX_M is deliberately absent: it broke
# bit-exact greedy parity (docs/result/s23-o6-o3o4-e2e.md) and does not ship.
# A human can copy the five env lines below into serve_host_dflash2.sh verbatim,
# together with promoting the .so named in this descriptor.
ARM_DESC="RECOMMENDED: cfg35 kernel .so + QUANT_FASTPATH=1 + EMU_FASTPATH=1, O4 gate off"
ARM_PROFILE="recommended-cfg35-quant-emu-o4off"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=1 VLLM_DCU_FP8_QUANT_FASTPATH=1 VLLM_DCU_FP8_FUSE_QUANT=0 VLLM_DCU_FP8_DECODE_CFG=35"
ARM_SO=${S23_CAND_SO:-7f87e185c628bd3c54c53ff9d5e0d78a}
ARM_EXPECT_GATE=off
ARM_PREFLIGHT_EXPECT="--expect VLLM_DCU_FP8_EMU_FASTPATH=1 --expect VLLM_DCU_FP8_QUANT_FASTPATH=1"
