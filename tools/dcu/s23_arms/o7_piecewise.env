# O7 arm: piecewise CUDA graphs, maintenance window only.
#
# The only difference from the control arm is the launcher: --enforce-eager is
# dropped and --compilation-config '{"cudagraph_mode":"piecewise"}' is added
# (tools/dcu/s23_launch_piecewise.sh). All three S23 python switches stay 0 so
# any measured difference belongs to the graph mode, not to O1/O2.
ARM_DESC="O7: --enforce-eager dropped + cudagraph_mode=piecewise"
ARM_PROFILE="o7-piecewise-cudagraph"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=0 VLLM_DCU_FP8_QUANT_FASTPATH=0 VLLM_DCU_FP8_FUSE_QUANT=0"
ARM_SO=""
ARM_LAUNCHER=/home/lyh/z100-vllm/tools/dcu/s23_launch_piecewise.sh
# Compile mode spends minutes in torch.compile before the engine is ready;
# 400 polls at ~3 s keeps the arm inside a ~20 min bound.
ARM_READY_TRIES=400
ARM_PREFLIGHT_EXPECT=""
