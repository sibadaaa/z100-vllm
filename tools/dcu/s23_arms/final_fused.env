# Final window (S23 close-out) O5 arm: identical to final_ctrl except
# VLLM_DCU_FP8_FUSE_QUANT=1, i.e. the fused quant+GEMM op replaces the
# two-launch quant -> GEMM chain.  Parity is the hard gate: the fused kernel is
# bit-exact at op level (`.s23/w2/O5/gate_final.log`, 6/6 shapes), so a parity
# break here would be a wiring bug.
ARM_DESC="FINAL O5: .so d209af95 + cfg35 + O1 + O2 + FUSE_QUANT=1"
ARM_PROFILE="final-cfg35-quant-emu-fuse1"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=1 VLLM_DCU_FP8_QUANT_FASTPATH=1 VLLM_DCU_FP8_FUSE_QUANT=1 VLLM_DCU_FP8_DECODE_CFG=35"
ARM_SO=${S23_CAND_SO:-d209af9585aaf0049394ced4a3c3211b}
ARM_EXPECT_GATE=off
ARM_PREFLIGHT_EXPECT="--expect VLLM_DCU_FP8_EMU_FASTPATH=1 --expect VLLM_DCU_FP8_QUANT_FASTPATH=1 --expect VLLM_DCU_FP8_FUSE_QUANT=1"
