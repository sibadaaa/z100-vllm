# O3 e2e control arm: baseline .so + the production decode config (cfg16).
# Same python tree as the candidate arm (the candidate needs no vllm/** change:
# VLLM_DCU_FP8_DECODE_CFG is read by the .cu itself), so the only difference
# between o3_control and cand35 is the build + that one knob.
ARM_DESC="O3 control: baseline .so f205be8f, DECODE_CFG=16, S23 switches off"
ARM_PROFILE="o3-control-baseline-so-cfg16"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=0 VLLM_DCU_FP8_QUANT_FASTPATH=0 VLLM_DCU_FP8_FUSE_QUANT=0 VLLM_DCU_FP8_DECODE_CFG=16"
ARM_SO=""
ARM_PREFLIGHT_EXPECT=""
# Kernel census falsifier: with the O4 gate on, the M=8 census must show
# wide2 and NO stream kernel for 5120:1536; with the gate off the stream kernel
# must still appear.
ARM_EXPECT_GATE=off
