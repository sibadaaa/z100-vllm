# Rollback drill, failure branch: promote a deliberately incompatible .so (the
# ROCm 10.1 stack's _rocm_C, md5 a250420b, built against torch 2.16/libhipblas.3)
# so the engine cannot load it. The arm must fail fast, and the window's restore
# path must (a) detect the drifted .so, (b) put the baseline back from
# /mnt/game/perf1/_rocm_C.f205be8f....so, (c) bring production back and (d) prove
# identity with the fixed-prompt smoke against the control arm.
ARM_DESC="rollback drill: wrong-ABI .so a250420b (expect start failure -> rollback)"
ARM_PROFILE="drill-wrong-abi-so"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=0 VLLM_DCU_FP8_QUANT_FASTPATH=0 VLLM_DCU_FP8_FUSE_QUANT=0"
ARM_SO=a250420bf88731fc2a1845a9b8abd379
ARM_READY_TRIES=40
ARM_PREFLIGHT_EXPECT=""
