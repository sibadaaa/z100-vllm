# Window Q discriminator arm (lead request after vllm-py's counter-evidence).
# Same artifact and the same O4 gate as cand35_qt_on, but DECODE_CFG=16, so the
# tile kernel for 5120:1536 is the pre-change cfg16 one. Interpretation:
#   parity FAILS here too  -> the stream->tile route change itself (or the
#                             harness) causes the divergence; cfg35 is exonerated.
#   parity PASSES here     -> cfg35's tile kernel differs from cfg16 on real
#                             engine data, so O4's numerics verdict stands and
#                             DECODE_CFG=16 + STREAM_MAX_M=8 becomes a variant.
# Parity only: no sweeps (host/kernel numbers for this combination are not the
# question, and it keeps the window short).
ARM_DESC="discriminator: .so 7f87e185 + DECODE_CFG=16 + STREAM_MAX_M=8 (parity only)"
ARM_PROFILE="cand-cfg16-o4-on-discriminator"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=0 VLLM_DCU_FP8_QUANT_FASTPATH=0 VLLM_DCU_FP8_FUSE_QUANT=0 VLLM_DCU_FP8_DECODE_CFG=16 VLLM_DCU_FP8_STREAM_MAX_M=8"
ARM_SO=${S23_CAND_SO:-7f87e185c628bd3c54c53ff9d5e0d78a}
ARM_EXPECT_GATE=on
ARM_SWEEP=off
# Kernel census stays ON for the discriminator: it must show wide2 for all five
# shapes and no stream kernel, so "the gate did not apply" is excluded.
ARM_CENSUS=1
ARM_PREFLIGHT_EXPECT=""
