# O3 candidate arm: kernel-dev's artifact + DECODE_CFG=35 (wide2 tile kernel).
# Candidate md5 is overridable so the same descriptor serves his next build:
#   S23_CAND_SO=<new-md5> bash tools/dcu/s23_ab.sh ... cand35
ARM_DESC="O3 candidate: ARM_SO artifact, DECODE_CFG=35 (wide2 tile)"
ARM_PROFILE="o3-cand-artifact-cfg35"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=0 VLLM_DCU_FP8_QUANT_FASTPATH=0 VLLM_DCU_FP8_FUSE_QUANT=0 VLLM_DCU_FP8_DECODE_CFG=35"
ARM_SO=${S23_CAND_SO:-7f87e185c628bd3c54c53ff9d5e0d78a}
ARM_PREFLIGHT_EXPECT=""
# Kernel census falsifier: with the O4 gate on, the M=8 census must show
# wide2 and NO stream kernel for 5120:1536; with the gate off the stream kernel
# must still appear.
ARM_EXPECT_GATE=off
