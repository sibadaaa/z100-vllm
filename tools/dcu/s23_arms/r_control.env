# Window R reference arm for the O7 piecewise check: the promoted artifact at the
# production config (cfg35, S23 switches off). Same build as r_piecewise, so the
# only difference between the two arms is the launcher (graph mode).
ARM_DESC="O7 reference: .so 7f87e185 + cfg35, eager launcher"
ARM_PROFILE="o7-ref-eager-cfg35"
ARM_ENV="VLLM_DCU_FP8_EMU_FASTPATH=0 VLLM_DCU_FP8_QUANT_FASTPATH=0 VLLM_DCU_FP8_FUSE_QUANT=0 VLLM_DCU_FP8_DECODE_CFG=35"
ARM_SO=${S23_CAND_SO:-7f87e185c628bd3c54c53ff9d5e0d78a}
ARM_EXPECT_GATE=off
ARM_PREFLIGHT_EXPECT=""
