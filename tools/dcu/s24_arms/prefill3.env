# S24 L2 treatment: prefill tile cfg 3 (BM64/BN128/TM4/TN8) for every prefill
# GEMM.  Kernel-level S24 measurement: +4.4% at M=2048 on 5120:4352.  Same tile
# family as cfg 0 (BK unchanged) so the plan expects bit-identical numerics;
# verified by the window's greedy parity check.
ARM_DESC="L2: VLLM_DCU_FP8_PREFILL_CFG=3"
ARM_ENV="VLLM_DCU_FP8_PREFILL_CFG=3"
ARM_SO=""
