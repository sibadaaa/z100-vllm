# S24 L5 soak arm: MBT=4096 at default UTIL=0.85 -- the HARDEST long-prefill
# OOM case (largest KV pool 16.21 GiB + halved but nonzero activation peak).
# util82 is strictly safer than this config, so passing here covers both.
ARM_DESC="L5 soak: MBT=4096, UTIL=0.85 (max pool + halved activation peak)"
ARM_ENV="MBT=4096 VLLM_DCU_FP8_PREFILL_CFG=0"
ARM_SO=""
