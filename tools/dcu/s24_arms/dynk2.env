# S24 L3.2 dynamic-k arm: truncate the speculative verify length by context
# length with a per-request acceptance EMA (design:
# docs/design/z100-s24-l3-dynamic-k-design.md).  Truncation cannot change the
# greedy output (the verify result is the target's own argmax prefix), so the
# window must show greedy parity 8/8 AND an ITL win at 32k with output t/s
# >= 95% of control.  Unset all three vars to restore shipped behaviour.
ARM_DESC="dynk repeat (ABAB position arm)"
ARM_ENV="VLLM_S24_DYNK_LO=16384 VLLM_S24_DYNK_HI=65536 VLLM_S24_DYNK_EMA=0.1"
ARM_SO=""
