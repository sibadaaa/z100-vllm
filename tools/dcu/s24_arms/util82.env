# S24 L5 arm: gpu-memory-utilization 0.82 (from 0.85) -- frees ~0.98 GiB of KV
# pool per card for activation headroom; the plan section 1.3 shows the real
# risk is the 1.8 GiB static margin, not KV occupancy.
ARM_DESC="L5: UTIL=0.82 (launcher knob)"
ARM_ENV="UTIL=0.82 VLLM_DCU_FP8_PREFILL_CFG=0"
ARM_SO=""
