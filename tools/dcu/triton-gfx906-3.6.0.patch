@@ -99,6 +99,26 @@ class HIPOptions:
         return hashlib.sha256(key.encode("utf-8")).hexdigest()
 
 
+# Hygon Z100 / gfx906 hazard: an SFU (transcendental) instruction that consumes
+# a VGPR written by the immediately preceding VALU instruction can read the
+# stale value for lanes 8-11 of every SIMD16. Reproduced with a six line
+# elementwise kernel on all four Z100 cards, with both the triton 3.4 and the
+# triton 3.6 builds (tl.exp2(m * 2.0) / tl.sqrt(m * 4.0) return the value of
+# the un-consumed VGPR). One wait slot before the SFU op makes the VALU result
+# visible; the sequence itself is unchanged otherwise.
+_SFU_OP_RE = re.compile(r"^\s*v_(?:exp|log|sqrt|rcp|rsq|sin|cos|ldexp)\w*")
+
+
+def insert_sfu_waits(asm: str, nops: int = 2) -> str:
+    out = []
+    for line in asm.splitlines():
+        if _SFU_OP_RE.match(line):
+            out.append("\ts_nop %d" % nops)
+        out.append(line)
+    out.append("")
+    return "\n".join(out)
+
+
 class HIPBackend(BaseBackend):
     instrumentation = None
     supports_native_tensor_specialization = False
@@ -465,6 +485,8 @@ class HIPBackend(BaseBackend):
 
     @staticmethod
     def make_hsaco(src, metadata, options):
+        if "gfx906" in options.arch:
+            src = insert_sfu_waits(src)
         target_features = ''
         if knobs.compilation.enable_asan:
             target_features = '+xnack'
