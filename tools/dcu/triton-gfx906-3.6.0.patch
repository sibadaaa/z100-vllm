@@ -12,6 +12,25 @@ from triton.runtime.build import compile_module_from_src
 
 dirname = os.path.dirname(os.path.realpath(__file__))
 include_dirs = [os.path.join(dirname, "include")]
+# Hygon DTK ships a hipDeviceProp_t that is much smaller than the one described
+# by the vendored HIP headers (792 B with gcnArchName at offset 396, against
+# 1472 B / 1160 for the vendored copy), so hipGetDeviceProperties() writes a
+# different layout than this file reads back. Compile the hip_utils module
+# against the headers of the HIP runtime that actually fills the struct, and
+# keep the vendored headers as a fallback for wheel installs without ROCm
+# headers. The launcher keeps using the vendored headers because it needs
+# HIP_LAUNCH_CONFIG, which stock DTK/ROCm headers may not define.
+_hip_include_dirs = []
+for _hip_root in (os.environ.get("ROCM_PATH"), os.environ.get("HIP_PATH"), "/opt/rocm"):
+    if not _hip_root:
+        continue
+    for _cand in (os.path.join(_hip_root, "hip", "include"), os.path.join(_hip_root, "include")):
+        if os.path.exists(os.path.join(_cand, "hip", "hip_runtime.h")):
+            _hip_include_dirs.append(_cand)
+            break
+    if _hip_include_dirs:
+        break
+include_dirs_utils = _hip_include_dirs + include_dirs
 PyTDMDescriptor = None
 
 
