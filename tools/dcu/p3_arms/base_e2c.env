# P3 arm — 由 docs/design/z100-rocm101-perf-p3-construction.md 定义
. "$(dirname "${BASH_SOURCE[0]}")/_common.env"
ARM_ID="P0.0"
ARM_DESC="基线复现：与 20261024-053333-E2C 逐字同配置"
ARM_EXPECT_GREP="W8A16 engaged=True"
ARM_GATE="复现 512c1 TTFT 2731ms / step 240.9ms，偏差 <=3%"
# 以下 5 个键 = E2C serve_launch.sh 的 EXTRA_ENV 原文，一个都不能增减
EXTRA_ENV="VLLM_DCU_USE_FP8_EMU=1 VLLM_DCU_FP8_GEMV_MAX_M=8 VLLM_DCU_FP8_W8A16=1 VLLM_DCU_FP16_PREFILL=1 VLLM_DCU_BF16=1"
