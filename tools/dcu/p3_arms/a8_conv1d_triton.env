# P3 arm — 由 docs/design/z100-rocm101-perf-p3-construction.md 定义
. "$(dirname "${BASH_SOURCE[0]}")/_common.env"
# 用法：source 本文件后再调 hosts/vllm-host.sh（见施工图 §3.2）
ARM_ID="A8"
ARM_DESC="conv1d Triton 路（消 149 次 DtoH；已知 wedge 风险，仅短 ctx）"
ARM_EXPECT_GREP=""        # arm 起来后必须在 serve.log 里 grep 到的证据（空=无）
ARM_GATE="FFR: 仅 64c1/512c1；出现 ring 空转立刻 kill"               # 通过判据（施工图 §4 对应任务卡）
EXTRA_ENV="VLLM_DCU_USE_FP8_EMU=1 VLLM_DCU_FP8_GEMV_MAX_M=8 VLLM_DCU_FP8_W8A16=1 VLLM_DCU_FP16_PREFILL=1 VLLM_DCU_BF16=1 VLLM_GFX906_TRITON_CAUSAL_CONV1D=1 VLLM_ROCM_USE_GFX906_TRITON_CAUSAL_CONV1D_UPDATE=1"
