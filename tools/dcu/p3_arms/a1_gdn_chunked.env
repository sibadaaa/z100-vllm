# P3 arm — 由 docs/design/z100-rocm101-perf-p3-construction.md 定义
. "$(dirname "${BASH_SOURCE[0]}")/_common.env"
# 用法：source 本文件后再调 hosts/vllm-host.sh（见施工图 §3.2）
ARM_ID="A1"
ARM_DESC="GDN prefill 走 FLA chunked（默认 0）"
ARM_EXPECT_GREP="chunked"        # arm 起来后必须在 serve.log 里 grep 到的证据（空=无）
ARM_GATE="TTFT 512c1 <= 2150ms（相对 P0.0 kernel 级 -20%）"               # 通过判据（施工图 §4 对应任务卡）
EXTRA_ENV="VLLM_DCU_USE_FP8_EMU=1 VLLM_DCU_FP8_GEMV_MAX_M=8 VLLM_DCU_FP8_W8A16=1 VLLM_DCU_FP16_PREFILL=1 VLLM_DCU_BF16=1 VLLM_GFX906_GDN_CHUNKED_PREFILL=1"
